{
  "name": "cyancliff-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把文档变成可引用、可核验的 Markdown",
  "scripts": {
    "cite:check": "node scripts/cite-check.mjs",
    "notify": "node scripts/notify.mjs",
    "find": "node scripts/find-quote.mjs",
    "mail:fetch": "node scripts/mail-fetch.mjs",
    "mail:auth": "node scripts/gmail-auth.mjs",
    "mail:draft": "node scripts/mail-draft.mjs",
    "workflow": "node scripts/workflow.mjs",
    "setup": "node scripts/setup.mjs",
    "test:credentials": "node scripts/test-credentials.mjs",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "test:hooks": "node scripts/run-sh.mjs scripts/test-hooks.sh",
    "test:feishu": "node scripts/test-feishu.mjs",
    "test:mutations": "node scripts/test-mutations.mjs",
    "publish": "node scripts/publish.mjs",
    "gate": "node scripts/gate.mjs",
